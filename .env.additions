# ── SEO / Analytics (add these to your .env on VPS) ──────────────
# Google Analytics 4 - get from analytics.google.com
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Google Tag Manager - get from tagmanager.google.com  
NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX

# Google Search Console verification - get from search.google.com/search-console
NEXT_PUBLIC_GOOGLE_VERIFICATION=your_verification_code

# Bing Webmaster - get from bing.com/webmasters
NEXT_PUBLIC_BING_VERIFICATION=your_bing_code

# Yandex Webmaster - get from webmaster.yandex.com
NEXT_PUBLIC_YANDEX_VERIFICATION=your_yandex_code
